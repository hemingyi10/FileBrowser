<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?actionBarSize"
        android:background="?colorSurface"
        android:elevation="@dimen/design_appbar_elevation"
        app:navigationIcon="@drawable/arrow_end_icon_white_24dp"
        app:navigationContentDescription="@string/close" />

    <HorizontalScrollView
        android:id="@+id/filterBarContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="?colorSurface"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/filterBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingLeft="12dp"
            android:paddingRight="12dp" />
    </HorizontalScrollView>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingTop="8dp"
            android:paddingBottom="8dp" />

        <TextView
            android:id="@+id/emptyView"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/category_empty"
            android:textColor="?android:textColorSecondary"
            android:textSize="15sp"
            android:visibility="gone" />
    </FrameLayout>

    <!-- 列表区与底栏之间的分隔线：类别内容较少时列表底部留白与底栏背景同为深色，
         视觉上会与操作行连成一片，导致“第二菜单栏过高”的误判；加 1dp 亮线明确底栏起点。 -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/category_bottom_bar_divider" />

    <include layout="@layout/category_file_list_fragment_bottom_bar_include" />
</LinearLayout>
